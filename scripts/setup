#!/bin/bash
set -euo pipefail
source "$(dirname -- "$0")/common.sh"

install=false
case "${1:-}" in
  '') ;;
  --install) install=true ;;
  --help|-h) printf 'Usage: scripts/setup [--install]\n'; exit 0 ;;
  *) printf 'Usage: scripts/setup [--install]\n' >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { printf 'Too many arguments\n' >&2; exit 2; }

# Check all destinations before installing or changing anything.
for relative in "${managed[@]}" .config/zsh/secrets.zsh; do
  safe_parent "$relative"
done
if [[ -L "$HOME/.config/zsh/secrets.zsh" ]]; then
  printf 'Keep secrets.zsh as a private regular file, not a symlink.\n' >&2
  exit 1
fi
if [[ -e "$HOME/.config/zsh/secrets.zsh" && ! -f "$HOME/.config/zsh/secrets.zsh" ]]; then
  printf 'secrets.zsh exists but is not a regular file.\n' >&2
  exit 1
fi

if "$install"; then
  [[ $(uname -s) == Darwin ]] || { printf 'Tool installation requires macOS.\n' >&2; exit 1; }
  brew_bin=$(find_brew) || { printf 'Install Homebrew first: https://brew.sh\n' >&2; exit 1; }
  brew_env=$("$brew_bin" shellenv)
  eval "$brew_env"
  "$brew_bin" bundle install --file="$repo/packages/Brewfile" --no-upgrade
  # Use only the declared global tools, not a config from the caller's directory.
  (
    cd /private/tmp
    export MISE_GLOBAL_CONFIG_FILE="$repo/home/.config/mise/config.toml"
    mise trust "$MISE_GLOBAL_CONFIG_FILE"
    mise install
  )
fi

umask 077
old_env="$HOME/.config/zsh/env.zsh"
secrets="$HOME/.config/zsh/secrets.zsh"
if ! correct_link .config/zsh/env.zsh && [[ -f "$old_env" && ! -e "$secrets" ]]; then
  mkdir -p "$HOME/.config/zsh"
  cp -pL "$old_env" "$secrets"
  chmod 600 "$secrets"
  printf 'Preserved old env.zsh as private secrets.zsh (contents not displayed).\n'
fi

backup_suffix="$(date +%Y%m%d-%H%M%S).$$"
for relative in "${managed[@]}"; do
  destination="$HOME/$relative"
  if correct_link "$relative"; then
    continue
  fi
  mkdir -p "$(dirname -- "$destination")"
  if [[ -e "$destination" || -L "$destination" ]]; then
    backup="$destination.dotfiles-backup.$backup_suffix"
    mv "$destination" "$backup"
    printf 'Backed up %s -> %s\n' "$destination" "$backup"
  fi
  ln -s "$repo/home/$relative" "$destination"
  printf 'Linked %s\n' "$destination"
done
printf 'Setup complete. Open a new login shell, then run scripts/doctor.\n'
