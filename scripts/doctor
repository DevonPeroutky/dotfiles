#!/bin/bash
set -uo pipefail
source "$(dirname -- "$0")/common.sh"
failures=0
missing() { printf 'CHECK: %s\n' "$*"; failures=$((failures + 1)); }

for relative in "${managed[@]}"; do
  if ! safe_parent "$relative" || ! correct_link "$relative"; then
    missing "Incorrect or missing link: $HOME/$relative (run scripts/setup)"
  fi
done

brew_bin=$(find_brew) || brew_bin=''
if [[ -n "$brew_bin" ]]; then
  # Disable automatic updates for this read-only check.
  HOMEBREW_NO_AUTO_UPDATE=1 "$brew_bin" bundle check --no-upgrade --verbose --file="$repo/packages/Brewfile" || missing 'Brewfile packages missing; run scripts/setup --install'
else
  missing 'Homebrew is missing; install it from https://brew.sh'
fi

for tool in git fzf wget mise nvim wt codex neovide uv node pnpm; do
  command -v "$tool" >/dev/null 2>&1 || missing "Command not on PATH: $tool (open a new login shell after setup)"
done

if ! find "$HOME/Library/Fonts" /Library/Fonts -iname '*Inconsolata*Nerd*' -print 2>/dev/null | /usr/bin/grep -q .; then
  missing 'Inconsolata Nerd Font missing; run scripts/setup --install'
fi
[[ -f /System/Library/Fonts/Monaco.ttf ]] || missing 'Monaco font not found in /System/Library/Fonts'

secrets="$HOME/.config/zsh/secrets.zsh"
if [[ -L "$secrets" ]]; then
  missing 'secrets.zsh should be a private regular file outside the repo'
elif [[ ! -f "$secrets" ]]; then
  missing 'Secrets not configured; copy examples/secrets.zsh.example if needed'
elif [[ $(stat -f '%Lp' "$secrets") != 600 ]]; then
  missing 'Set private permissions: chmod 600 ~/.config/zsh/secrets.zsh'
fi

if [[ $failures -eq 0 ]]; then
  printf 'All checks passed.\n'
else
  printf '%s check(s) need attention. No files were changed.\n' "$failures"
  exit 1
fi
